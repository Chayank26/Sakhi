PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sakhi?retryWrites=true&w=majority
FRONTEND_URL=https://your-frontend-domain.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app

# Email Notifications (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL="Sakhi Careers <your_email@gmail.com>"

# Cloud LLM Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Shared deadline across Gemini requests, retries and tool rounds (1000–45000 ms).
GEMINI_TIMEOUT_MS=45000
# Retries only for transient errors; never retry quota/auth/client errors (0–2).
GEMINI_MAX_RETRIES=1

# Must match the frontend Firebase project. Protected routes fail closed if unset.
FIREBASE_PROJECT_ID=your_project_id
# Alternatively set FIREBASE_SERVICE_ACCOUNT_KEY to the service-account JSON in your secret manager.

# Production runtime (Node >=22.12). Set NODE_ENV=production on your host.
NODE_ENV=development
# Public API origin used to build image URLs; never derived from request Host.
PUBLIC_API_ORIGIN=http://localhost:5001
# In production, use an absolute path on a persistent volume, e.g. /var/lib/sakhi/uploads.
# UPLOAD_DIR=/var/lib/sakhi/uploads
# Leave 0 for direct connections. Set only to match your actual trusted proxy topology.
TRUST_PROXY=0
